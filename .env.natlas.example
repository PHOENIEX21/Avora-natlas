# N-ATLAS / NAIC Voice-First Access
# Official ASR model for the first competition milestone.
NATLAS_ASR_MODEL="NCAIR1/NigerianAccentedEnglish"
# Set this to the official/self-hosted N-ATLAS ASR HTTP endpoint once deployed.
NATLAS_ASR_ENDPOINT=""
# Optional bearer token for a protected ASR runtime. Never expose this with NEXT_PUBLIC_.
NATLAS_ASR_TOKEN=""
NEXT_PUBLIC_NATLAS_VOICE_ENABLED="false"

# Server-controlled competition evidence phase. Keep DEVELOPMENT while building.
# Change deliberately to PILOT, then VALIDATION only for genuine real-user sessions.
NATLAS_EVIDENCE_MODE="DEVELOPMENT"
